# Google Cloud / Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Agent Model (default: gemini-2.5-flash)
AGENT_MODEL=gemini-2.5-flash

# ---------- Git MCP Server Configuration ----------
# Option A: Stdio-based MCP server (recommended for local dev)
# Uses npx to run the GitHub MCP server
GIT_MCP_SERVER_CMD=npx
GIT_MCP_SERVER_ARGS=-y @modelcontextprotocol/server-github

# Option B: SSE-based MCP server (for remote/hosted MCP servers)
# GIT_MCP_SERVER_URL=http://localhost:3000/sse

# GitHub token for private repo access (used by Git MCP server)
GITHUB_TOKEN=
